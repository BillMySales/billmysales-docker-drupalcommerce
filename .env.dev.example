# Development environment. Usage: cp .env.dev.example .env && docker compose up -d --build
# Every variable is documented in .env.prod.example.

# Mailpit catches all outgoing mail: http://localhost:8025
COMPOSE_PROFILES=mailpit

# Local URL (shop at /, admin at /admin), plain HTTP on port 8117.
DRUPAL_URL=http://localhost:8117
SITE_ADDRESS=:80
HTTP_PORT=8117
HTTPS_PORT=8417
MAILPIT_PORT=8025
PHP_DISPLAY_ERRORS=On
DRUPAL_ERROR_LEVEL=verbose

# Develop a custom module mounted from the host (see overrides/module.yaml):
#COMPOSE_FILE=compose.yaml:overrides/module.yaml
#MODULE_PATH=../billmysales-plugin-drupalcommerce
#MODULE_NAME=billmysales

# Dev-only secrets and credentials.
DRUPAL_HASH_SALT=dev-hash-salt-dev-hash-salt-dev-hash-salt-dev-hash-salt-0000
DB_PASSWORD=drupal
DB_ROOT_PASSWORD=root
DRUPAL_ADMIN_EMAIL=admin@example.com
DRUPAL_ADMIN_PASSWORD=admin12345
DRUPAL_SITE_NAME=Tienda

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=none
SMTP_FROM=shop@example.com
