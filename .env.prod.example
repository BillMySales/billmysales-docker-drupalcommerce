# Production environment. Usage: cp .env.prod.example .env, fill in the
# REQUIRED values, then docker compose up -d --build
# Commented-out lines show the default value.

# ---------------------------------------------------------------------------
# Optional services, comma separated: backup, mailpit (dev only), tools
# (console).
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=backup
#COMPOSE_PROJECT_NAME=drupalcommerce

# Optional overrides (see overrides/*.yaml), combined with ":", e.g.
#COMPOSE_FILE=compose.yaml:overrides/traefik.yaml:overrides/local-dirs.yaml
# overrides/traefik.yaml: publish through an existing Traefik (then set
# SITE_ADDRESS=:80 below).
#TRAEFIK_HOST=shop.example.com
#TRAEFIK_NETWORK=shared_network
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
# overrides/local-dirs.yaml: data in local directories instead of volumes.
#DATA_DIR=./data
# overrides/module.yaml: a custom module mounted from the host (development).
#MODULE_PATH=../my_module
#MODULE_NAME=my_module

# ---------------------------------------------------------------------------
# Site and network
# ---------------------------------------------------------------------------
# REQUIRED. Public URL of the shop (the admin is <url>/admin, the login
# <url>/user/login). Its host is the only one Drupal answers to (trusted host
# patterns); Drush uses the URL for links in emails sent by cron.
DRUPAL_URL=https://shop.example.com
# Other host names Drupal answers to (comma separated), e.g. www.example.com.
#DRUPAL_EXTRA_HOSTS=
# Caddy site address: a domain gets an automatic Let's Encrypt certificate
# (DNS must point here and ports 80/443 must be reachable). Use ":80" behind
# another TLS-terminating proxy, or "localhost" for local HTTPS.
SITE_ADDRESS=shop.example.com
# Interface to publish ports on: 0.0.0.0 = all (public server).
HTTP_BIND=0.0.0.0
#HTTP_PORT=80
#HTTPS_PORT=443
#TIMEZONE=America/Santiago

# ---------------------------------------------------------------------------
# Secrets and credentials (REQUIRED, use long random values: openssl rand -hex 32)
# ---------------------------------------------------------------------------
# Drupal's hash salt (one-time login links, form tokens). Changing it logs
# everyone out and invalidates password reset links. Not in the backups:
# keep a copy.
DRUPAL_HASH_SALT=
DB_PASSWORD=
DB_ROOT_PASSWORD=
# First admin user (created on the first install; its password is set only then).
DRUPAL_ADMIN_EMAIL=
DRUPAL_ADMIN_PASSWORD=
#DRUPAL_ADMIN_USER=admin
#DB_USER=drupal
#DB_NAME=drupal

# ---------------------------------------------------------------------------
# Site and store (initial settings: each one is created only if missing,
# later changes in the admin are kept)
# ---------------------------------------------------------------------------
#DRUPAL_SITE_NAME=Drupal Commerce
# Language of the install; its translations are downloaded from
# localize.drupal.org during the first install (needs internet access).
#DRUPAL_LOCALE=es
#COMMERCE_CURRENCY=CLP
#COMMERCE_COUNTRY=CL
#COMMERCE_CITY=Santiago
# Tax rate (%) of the country's tax type; empty = none.
#COMMERCE_TAX_RATE=19
#COMMERCE_TAX_NAME=IVA
# Prices include tax (as usual in Chile).
#COMMERCE_PRICES_INCLUDE_TAX=true

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# Drupal core, Commerce and Drush, built into the image (image/Dockerfile).
# After changing them, `docker compose up -d --build` rebuilds and `setup`
# runs the database updates. Back up first. Composer refuses versions with a
# known security advisory.
#DRUPAL_VERSION=11.4.7
#COMMERCE_VERSION=3.3.10
#DRUSH_VERSION=13.8.0
# More Composer packages built into the image (contrib modules, themes),
# space separated; enable modules afterwards with Drush (see README).
#DRUPAL_EXTRA_PACKAGES=drupal/commerce_shipping:^3
#PHP_VERSION=8.5
#DRUPAL_IMAGE=drupalcommerce-fpm
#MARIADB_VERSION=12.3
#CADDY_VERSION=2.11
#MAILPIT_VERSION=v1.31

# ---------------------------------------------------------------------------
# Mail (SMTP): order receipts, account emails, password resets, contact
# forms. Without SMTP_HOST Drupal uses PHP's mail(), which this image can't
# deliver.
# ---------------------------------------------------------------------------
SMTP_HOST=
#SMTP_PORT=587
# tls (STARTTLS when the server offers it, usually port 587), ssl (SMTPS,
# port 465) or none (never TLS).
#SMTP_SECURE=tls
#SMTP_USER=
#SMTP_PASSWORD=
# Sender address of the site's and the store's emails.
#SMTP_FROM=no-reply@example.com

# ---------------------------------------------------------------------------
# Scheduled work and backups
# ---------------------------------------------------------------------------
# Seconds between Drupal cron runs (queues, cleanup, abandoned carts).
#CRON_INTERVAL=300
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP_DAYS=7

# ---------------------------------------------------------------------------
# PHP, resources and logs
# ---------------------------------------------------------------------------
# Drupal's error display: hide (production), some, all or verbose.
#DRUPAL_ERROR_LEVEL=hide
#PHP_MEMORY_LIMIT=512M
#PHP_MAX_EXECUTION_TIME=120
#PHP_DISPLAY_ERRORS=Off
# 1 = PHP checks files for changes (only useful when editing code in place).
#PHP_OPCACHE_VALIDATE_TIMESTAMPS=0
#PHP_FPM_MAX_CHILDREN=10
#PHP_FPM_START_SERVERS=2
#PHP_FPM_MIN_SPARE_SERVERS=1
#PHP_FPM_MAX_SPARE_SERVERS=4
#PHP_FPM_MAX_REQUESTS=500
#UPLOAD_MAX_SIZE=32M
#DB_MEMORY_LIMIT=1g
#SETUP_MEMORY_LIMIT=1g
#PHP_MEMORY_LIMIT_CONTAINER=1g
#CRON_MEMORY_LIMIT=512m
#CONSOLE_MEMORY_LIMIT=1g
#CADDY_MEMORY_LIMIT=256m
#BACKUP_MEMORY_LIMIT=512m
#LOG_MAX_SIZE=10m
#LOG_MAX_FILE=3
